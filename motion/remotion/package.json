{
  "name": "onhost-motion",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "studio": "npm run prepare:assets && remotion studio src/index.tsx",
    "render": "node scripts/render.mjs",
    "render:power-on": "node scripts/render.mjs power-on",
    "render:power-on-portrait": "node scripts/render.mjs power-on-portrait",
    "render:power-on-loop": "node scripts/render.mjs power-on-loop",
    "render:power-on-loop-portrait": "node scripts/render.mjs power-on-loop-portrait",
    "render:deploy": "node scripts/render.mjs deploy",
    "render:constellation": "node scripts/render.mjs constellation",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "remotion": "4.0.535",
    "@remotion/cli": "4.0.535",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@fontsource/league-spartan": "5.3.0",
    "@fontsource-variable/inter": "5.3.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0"
  }
}
