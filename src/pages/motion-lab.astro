---
import Base from '../layouts/Base.astro';
import Cosmos from '../components/motion/Cosmos.astro';
import PowerSwitch from '../components/motion/PowerSwitch.astro';
import Orbit from '../components/motion/Orbit.astro';
import Reveal from '../components/motion/Reveal.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Motion lab" description="Technická ukázka pohybového systému ONhost.">
  <main>
    <section class="scene" aria-labelledby="lab-title">
      <Cosmos id="lab-cosmos" on={false} planet />
      <div class="scene-content">
        <p class="eyebrow">Motion lab · technická ukázka</p>
        <h1 id="lab-title">Zapni svůj vesmír</h1>
        <div class="power-stage"><PowerSwitch target="lab-cosmos" size={100} /></div>
        <p>Stiskni symbol. Rozsviť síť na horizontu svého vesmíru.</p>
        <a href={`${base}/`}>Zpět na návrh →</a>
      </div>
    </section>
    <section class="examples" aria-label="Oběžné dráhy a odkrývání">
      <Reveal><h2>Oběžné dráhy</h2><p>Klidný pohyb kolem obsahu.</p></Reveal>
      <div class="cards">
        {[0,1,2].map((i) => <Reveal delay={i*90}><article><Orbit size="100%" rings={i+1} duration={40+i*12}><span class="sample">{['Web','Orbit','Síť'][i]}</span><span slot="planets" class="custom-planet"></span></Orbit></article></Reveal>)}
      </div>
      <Reveal><p>Ukázkový text · dekorativní motivy, žádné údaje o službě.</p><a href={`${base}/motion-lab?transition=demo`}>Vyzkoušet přechod stránky →</a></Reveal>
    </section>
  </main>
</Base>
<style>
  .scene { position:relative; min-height:850px; min-height:min(980px, 100svh); display:grid; place-items:center; padding:64px 16px; }
  .scene-content { position:relative; z-index:1; display:flex; align-items:center; flex-direction:column; text-align:center; max-width:100%; padding-bottom:24svh; }
  .power-stage { display:grid; place-items:center; height:clamp(220px,32svh,300px); }
  h1 { font-size:clamp(40px,7vw,88px); margin:20px 0; line-height:1; }
  h2 { font-size:clamp(32px,5vw,56px); }
  .eyebrow { font-size:12px; letter-spacing:.15em; text-transform:uppercase; }
  .scene p { max-width:32em; }
  .examples { max-width:1240px; margin:auto; padding:100px var(--gutter); }
  .cards { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; margin:48px 0; }
  article { background:#3c096c25; border:1px solid #bb88eb25; border-radius:18px; padding:24px; }
  .sample { font-family:var(--font-display); font-size:36px; }
  .custom-planet { position:absolute; top:14%; left:19%; width:6px; height:6px; border-radius:50%; background:var(--lilac-200); }
  @media(max-width:680px) { .cards { grid-template-columns:1fr; } .scene { min-height:100svh; } }
</style>
