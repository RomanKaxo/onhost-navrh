---
import Site from '../layouts/Site.astro';
import Logo from '../components/Logo.astro';
import Button from '../components/Button.astro';
import SectionHead from '../components/SectionHead.astro';
import Highlights from '../components/Highlights.astro';
import Plans from '../components/Plans.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Cosmos from '../components/motion/Cosmos.astro';
import {getEntry} from 'astro:content';
import {url} from '../data/nav';
import {planetFor} from '../data/planets';
import {stepsTitle} from '../data/defaults';
const page = await getEntry('pages', 'home');
const d = page?.data;
// H1 ve dvou tónech: první věta bílá, zbytek levandulový.
const headline = d?.headline ?? 'Zapněte svůj web. My se postaráme o zbytek.';
const [first, ...rest] = headline.split(/(?<=\.)\s+/);
// Produkty jako planety na oběžných drahách kolem symbolu (ring = vzdálenost od středu, at = výchozí úhel).
const planets = [
  {label: 'Webhosting', href: 'webhosting', key: 'web', ring: 1, at: .05},
  {label: 'WordPress', href: 'wordpress-hosting', key: 'wordpress', ring: 1, at: .55},
  {label: 'VPS', href: 'vps', key: 'vps', ring: 2, at: .2},
  {label: 'Domény', href: 'domeny', key: 'domains', ring: 2, at: .7},
  {label: 'Gamehosting', href: 'gamehosting', key: 'game', ring: 3, at: .38},
  {label: 'E-mail', href: 'mailhosting', key: 'mail', ring: 3, at: .88},
  {label: 'Dedikované servery', href: 'dedikovane-servery', key: 'dedicated', ring: 4, at: .12},
  {label: 'Databáze', href: 'databaze', key: 'database', ring: 4, at: .6},
].map(p => ({...p, look: planetFor(p.key)}));
const dcStars: [number, number][] = [[60, 220], [150, 140], [230, 170], [320, 80], [190, 60], [300, 230]];
---
<Site title={d?.title ?? 'Hosting'} description={d?.description ?? ''}>
  <section class="hero" data-power-scene>
    <Cosmos id="hero-cosmos" on={false} class="hero__cosmos" />
    <div class="wrap hero__inner">
      <div class="hero__stage">
        <span class="hero__ring" aria-hidden="true"></span><span class="hero__ring hero__ring--2" aria-hidden="true"></span>
        <button class="hero__switch" type="button" aria-pressed="false" aria-controls="hero-cosmos" data-power aria-label="Zapnout vesmír ONhost">
          <Logo variant="symbol" tone="on-dark" label="ONhost" />
        </button>
        <p class="hero__state" aria-live="polite"><span data-power-state>OFF</span></p>
      </div>
      <div class="hero__copy">
        <p class="eyebrow">{d?.eyebrow ?? 'Hosting ONhost'}</p>
        <h1>{first}{rest.length > 0 && <> <span>{rest.join(' ')}</span></>}</h1>
        {d?.lead && <p class="lead">{d.lead}</p>}
        <form class="domain" action={url('domeny')} method="get" role="search">
          <label class="sr-only" for="domain-q">Najděte si doménu</label>
          <input id="domain-q" name="q" placeholder="vase-firma.cz" autocomplete="off" />
          <Button type="submit">Ověřit doménu</Button>
        </form>
        {d?.included && <ul class="chips" aria-label="V ceně">{d.included.slice(0, 3).map(i => <li>{i}</li>)}</ul>}
      </div>
    </div>
    <a class="hero__scroll" href="#produkty" aria-label="Posunout na produkty"><span></span></a>
  </section>

  <section class="section" id="produkty">
    <div class="wrap">
      <SectionHead eyebrow="Produkty" title="Jeden vesmír. Všechno pro váš web." lead="Od prvního webu po dedikovaný server. Jeden účet, jedna klientská zóna a jedna podpora, která zná celý váš projekt." />
      <div class="system">
        <ul class="system__list">
          {planets.map((p, i) => <li data-reveal style={`--d:${i * 40}ms`}><a class="card" href={url(p.href)}><span class="orb-dot" style={`--c1:${p.look.c1};--c2:${p.look.c2}`}></span>{p.label}<span aria-hidden="true" class="system__arrow">→</span></a></li>)}
        </ul>
        <div class="system__orbit" aria-hidden="true" data-orbit>
          {[1, 2, 3, 4].map(r => <div class="ring" style={`--ring:${r}`}>
            {planets.filter(p => p.ring === r).map(p => <a class="orb" href={url(p.href)} tabindex="-1" style={`--at:${p.at};--c1:${p.look.c1};--c2:${p.look.c2}`}><span class="orb-dot"></span><span class="orb__label">{p.label}</span></a>)}
          </div>)}
          <div class="system__core"><Logo variant="symbol" tone="on-dark" /></div>
        </div>
      </div>
    </div>
  </section>

  {d?.highlights?.length && <Highlights items={d.highlights} eyebrow="Proč ONhost" title="Prémiový hosting, který nemusíte hlídat." />}

  {d?.plans?.length && <Plans plans={d.plans} note={d.priceNote} eyebrow="Ceník webhostingu" title="Férové ceny. Bez hvězdiček." id="cenik" />}

  {d?.steps?.length && <Steps items={d.steps} title={stepsTitle(d.steps.length)} />}

  <section class="section">
    <div class="wrap dc">
      <div class="dc__copy" data-reveal>
        <p class="eyebrow">Infrastruktura</p>
        <h2>Datacentrum v srdci Evropy.</h2>
        <p class="lead">Vlastní infrastruktura v datacentru Tier III v Praze. Redundantní napájení i konektivita a SLA 99,9 %.</p>
        <Button href={url('datacenter')} variant="ghost">Prohlédnout datacentrum</Button>
      </div>
      <div class="card dc__map" aria-hidden="true" data-reveal>
        <svg viewBox="0 0 400 300">
          <g class="dc__lines"><path pathLength="1" d="M60 220 L150 140 L230 170 L320 80 M150 140 L190 60 L320 80 M230 170 L300 230" /></g>
          <g class="dc__stars">{dcStars.map(([x, y], i) => <circle cx={x} cy={y} r={i === 1 ? 7 : 4} style={`--d:${300 + i * 140}ms`} />)}</g>
        </svg>
        <p class="dc__label">Praha · Tier III</p>
      </div>
    </div>
  </section>

  {d?.faq?.length && <Faq items={d.faq} />}

  {d?.cta && <CtaBand title={d.cta.title} text={d.cta.text} primary={d.cta.primary} secondary={d.cta.secondary} />}
</Site>

<script>
  // Vypínač: „stisk“ = rovnoměrné zmenšení symbolu; zapnutí rozsvítí vesmír kolem. Logo se jinak nemění.
  import {onPage} from '../motion/lifecycle.js';
  import {getCosmos} from '../motion/cosmos.js';
  onPage(() => {
    const scene = document.querySelector<HTMLElement>('[data-power-scene]');
    const button = document.querySelector<HTMLButtonElement>('[data-power]');
    const state = document.querySelector('[data-power-state]');
    if (!scene || !button) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const setOn = (on: boolean) => {
      scene.classList.toggle('is-on', on);
      button.setAttribute('aria-pressed', String(on));
      button.setAttribute('aria-label', on ? 'Vypnout vesmír ONhost' : 'Zapnout vesmír ONhost');
      if (state) state.textContent = on ? 'ON' : 'OFF';
      getCosmos(document.getElementById('hero-cosmos'))?.setPower(on, {duration: 1800});
    };
    const press = () => {
      button.classList.remove('is-pressed'); void button.offsetWidth; button.classList.add('is-pressed');
      setOn(!scene.classList.contains('is-on'));
    };
    button.addEventListener('click', press);
    // Bez interakce se vesmír zapne sám; kdo nechce pohyb, vidí rovnou zapnutý stav.
    const timer = reduce ? (setOn(true), 0) : window.setTimeout(() => { if (!scene.classList.contains('is-on')) press(); }, 1400);
    // Oběžné dráhy běží jen ve viewportu.
    const orbit = document.querySelector('[data-orbit]');
    const io = orbit && new IntersectionObserver(([e]) => orbit.classList.toggle('is-paused', !e.isIntersecting));
    if (orbit && io) io.observe(orbit);
    return () => { clearTimeout(timer); button.removeEventListener('click', press); io?.disconnect(); };
  });
</script>

<style>
  /* HERO — začíná ve tmě; stisk symbolu rozsvítí mlhovinu a hvězdy (WebGL, se statickou zálohou). */
  .hero { position: relative; min-height: calc(100svh - 32px); margin-top: -76px; padding-top: 76px; display: grid; align-items: center; isolation: isolate; }
  .hero :global(.hero__cosmos) { z-index: -1; -webkit-mask-image: linear-gradient(#000 72%, transparent); mask-image: linear-gradient(#000 72%, transparent); }
  .hero__inner { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-items: center; gap: clamp(32px, 6vw, 96px); padding-block: 56px 96px; }
  .hero__stage { position: relative; justify-self: center; display: grid; place-items: center; width: clamp(200px, 26vw, 360px); aspect-ratio: 1; }
  .hero__switch { width: 74%; aspect-ratio: 1; border-radius: 50%; border: 0; background: none; cursor: pointer; padding: 0; }
  .hero__switch :global(.logo) { width: 100%; }
  .hero__switch.is-pressed :global(.logo) { animation: press 220ms var(--ease); }
  @keyframes press { 50% { scale: .94; } }
  .hero__switch:focus-visible { outline: 2px solid var(--lilac-200); outline-offset: 14px; }
  /* Oběžné dráhy kolem symbolu se po zapnutí roztáhnou a rozsvítí — mimo ochrannou zónu loga. */
  .hero__ring { position: absolute; inset: -4%; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--lilac) 0%, transparent); scale: .82; opacity: 0;
    transition: scale var(--t-scene) var(--ease), opacity var(--t-scene) var(--ease), border-color var(--t-scene) var(--ease); }
  .hero__ring--2 { inset: -26%; border-style: dashed; transition-delay: .2s; }
  .hero.is-on .hero__ring { scale: 1; opacity: 1; border-color: color-mix(in srgb, var(--lilac) 34%, transparent); }
  .hero.is-on .hero__ring--2 { border-color: color-mix(in srgb, var(--lilac) 18%, transparent); animation: spin 120s linear infinite; }
  @keyframes spin { to { rotate: 360deg; } }
  .hero__state { position: absolute; bottom: -18%; margin: 0; font: 600 12px/1 var(--font-body); letter-spacing: .3em; color: var(--text-faint); transition: color var(--t-move) var(--ease); }
  .hero.is-on .hero__state { color: var(--pink-hot); }
  .hero__copy { display: grid; gap: 24px; justify-items: start; opacity: .14; translate: 0 18px; transition: opacity var(--t-scene) var(--ease), translate var(--t-scene) var(--ease); }
  .hero.is-on .hero__copy { opacity: 1; translate: 0 0; }
  .hero h1 { font-size: var(--fs-display); font-weight: 700; }
  .hero h1 span { color: var(--lilac-200); }
  .domain { display: flex; gap: 8px; width: min(100%, 560px); padding: 8px; border-radius: 999px; background: color-mix(in srgb, var(--space-0) 55%, transparent); border: 1px solid var(--line-strong); backdrop-filter: blur(12px); }
  .domain input { flex: 1; min-width: 0; border: 0; background: none; color: #fff; font: 500 16px var(--font-body); padding: 0 16px; }
  .domain input::placeholder { color: var(--text-faint); }
  .domain input:focus { outline: none; }
  .domain:focus-within { border-color: var(--lilac-200); }
  .hero__scroll { position: absolute; left: 50%; bottom: 28px; translate: -50% 0; width: 26px; height: 42px; border-radius: 999px; border: 1px solid var(--line-strong); }
  .hero__scroll span { position: absolute; left: 50%; top: 9px; width: 3px; height: 8px; margin-left: -1.5px; border-radius: 2px; background: var(--lilac-200); animation: scrolly 2s var(--ease) infinite; }
  @keyframes scrolly { 60% { translate: 0 12px; opacity: 0; } }

  /* PRODUKTY — planety obíhají po kružnici (offset-path), takže popisky zůstávají vodorovně. */
  #produkty { overflow-x: clip; }
  .system { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(32px, 6vw, 88px); align-items: center; }
  .system__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .system__list a { display: flex; align-items: center; gap: 12px; padding: 16px 18px; font-weight: 600; color: #fff; }
  .system__arrow { margin-left: auto; color: var(--lilac); transition: translate var(--t-micro) var(--ease); }
  .system__list a:hover .system__arrow { translate: 3px 0; color: #fff; }
  .orb-dot { width: 14px; height: 14px; border-radius: 50%; flex: none; background: radial-gradient(circle at 32% 30%, #fff 0%, var(--c1) 35%, var(--c2) 85%); box-shadow: 0 0 16px color-mix(in srgb, var(--c1) 60%, transparent); }
  .system__orbit { position: relative; aspect-ratio: 1; width: 100%; max-width: 620px; justify-self: center; }
  .ring { position: absolute; --r: calc(15% + (var(--ring) - 1) * 11.4%); inset: calc(50% - var(--r)); border-radius: 50%; border: 1px dashed color-mix(in srgb, var(--lilac) 22%, transparent); }
  .orb { position: absolute; left: 0; top: 0; width: 20px; height: 20px; display: grid; place-items: center; pointer-events: auto;
    offset-path: circle(50% at 50% 50%); offset-rotate: 0deg; --spin: calc(70s + var(--ring) * 24s);
    animation: travel var(--spin) linear infinite; animation-delay: calc(var(--spin) * var(--at) * -1); }
  .ring:nth-child(even) .orb { animation-direction: reverse; }
  .orb .orb-dot { width: 20px; height: 20px; }
  .orb__label { position: absolute; top: calc(100% + 8px); left: 50%; translate: -50% 0; font: 600 12.5px/1 var(--font-body); white-space: nowrap; color: var(--lilac-50); opacity: .85; text-decoration: none; }
  @keyframes travel { to { offset-distance: 100%; } }
  .system__orbit.is-paused .orb { animation-play-state: paused; }
  .system__core { position: absolute; inset: 41%; display: grid; place-items: center; }
  .system__core :global(.logo) { width: 100%; }

  /* DATACENTRUM — souhvězdí, linky se při odkrytí dokreslí a hvězdy rozsvítí. */
  .dc { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 88px); align-items: center; }
  .dc__copy { display: grid; gap: 20px; justify-items: start; }
  .dc__copy h2 { font-size: var(--fs-h2); max-width: 14ch; }
  .dc__map { padding: 28px; background: radial-gradient(circle at 40% 45%, color-mix(in srgb, var(--brand) 60%, transparent), transparent 75%), var(--surface); }
  .dc__lines path { fill: none; stroke: color-mix(in srgb, var(--lilac) 50%, transparent); stroke-width: 1; stroke-dasharray: 1; stroke-dashoffset: 0; transition: stroke-dashoffset 2.4s var(--ease) .2s; }
  .dc__map.reveal-pending .dc__lines path { stroke-dashoffset: 1; }
  .dc__stars circle { fill: var(--lilac-50); transition: opacity .6s var(--ease) var(--d); }
  .dc__map.reveal-pending .dc__stars circle { opacity: 0; }
  .dc__stars circle:nth-child(2) { fill: var(--pink); }
  .dc__label { position: absolute; left: 36%; top: 40%; margin: 0; font: 600 13px/1 var(--font-body); color: #fff; }

  @media (max-width: 960px) {
    .hero__inner, .system, .dc { grid-template-columns: minmax(0, 1fr); }
    .hero__inner { padding-block: 32px 96px; gap: 56px; }
    .hero__stage { width: 190px; }
    .orb__label { display: none; }
  }
  @media (max-width: 560px) { .system__list { grid-template-columns: minmax(0, 1fr); } .domain { flex-direction: column; border-radius: 22px; } .domain :global(.btn) { width: 100%; } .domain input { padding: 12px 14px; } }
</style>
