---
import Site from '../layouts/Site.astro';
import Logo from '../components/Logo.astro';
import Button from '../components/Button.astro';
import SectionHead from '../components/SectionHead.astro';
import Highlights from '../components/Highlights.astro';
import Plans from '../components/Plans.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Cosmos from '../components/motion/Cosmos.astro';
import WorldMap from '../components/WorldMap.astro';
import Marquee from '../components/Marquee.astro';
import Stats from '../components/Stats.astro';
import {getEntry, getCollection} from 'astro:content';
import PlanetArt from '../components/PlanetArt.astro';
import {nav} from '../data/nav';
import {url} from '../data/nav';
import {planetFor} from '../data/planets';
import {stepsTitle} from '../data/defaults';
const page = await getEntry('pages', 'home');
const d = page?.data;
// H1 ve dvou tónech: první věta bílá, zbytek levandulový.
const headline = d?.headline ?? 'Zapněte svůj web. My se postaráme o zbytek.';
const [first, ...rest] = headline.split(/(?<=\.)\s+/);
// Produkty jako planety na oběžných drahách kolem symbolu (ring = vzdálenost od středu, at = výchozí úhel).
const planets = [
  {label: 'Webhosting', href: 'webhosting', key: 'web', ring: 1, at: .05},
  {label: 'WordPress', href: 'wordpress-hosting', key: 'wordpress', ring: 1, at: .55},
  {label: 'VPS', href: 'vps', key: 'vps', ring: 2, at: .2},
  {label: 'Domény', href: 'domeny', key: 'domains', ring: 2, at: .7},
  {label: 'Gamehosting', href: 'gamehosting', key: 'game', ring: 3, at: .38},
  {label: 'E-mail', href: 'mailhosting', key: 'mail', ring: 3, at: .88},
  {label: 'Dedikované servery', href: 'dedikovane-servery', key: 'dedicated', ring: 4, at: .12},
  {label: 'Databáze', href: 'databaze', key: 'database', ring: 4, at: .6},
].map(p => ({...p, look: planetFor(p.key)}));
// Cena „od“ jen tam, kde má stránka tarify (nejnižší cena z obsahu, beze změny formátu).
const pages = await getCollection('pages');
const fromPrice = (slug: string) => {
  const plans = pages.find(x => x.data.slug === slug)?.data.plans ?? [];
  const priced = plans.map(pl => ({pl, n: Number(pl.price.replace(/[^\d,]/g, '').replace(',', '.'))})).filter(x => x.n > 0).sort((a, b) => a.n - b.n)[0];
  return priced ? `od ${priced.pl.price.replace(/^od\s+/i, '')}${priced.pl.period ? ` / ${priced.pl.period}` : ''}` : '';
};
const noteOf = (slug: string) => nav.flatMap(g => g.items).find(i => i.href === slug)?.note ?? '';
const catalog = planets.map(p => ({...p, note: noteOf(p.href), from: fromPrice(p.href)}));
---
<Site title={d?.title ?? 'Hosting'} description={d?.description ?? ''}>
  <section class="hero" data-power-scene>
    <Cosmos id="hero-cosmos" on={false} class="hero__cosmos" planet={{x: .5, y: 1.8, radius: 1.04}} />
    <div class="wrap hero__inner">
      <div class="hero__stage">
        <span class="hero__ring" aria-hidden="true"></span><span class="hero__ring hero__ring--2" aria-hidden="true"></span>
        <button class="hero__switch" type="button" aria-pressed="false" aria-controls="hero-cosmos" data-power aria-label="Zapnout vesmír ONhost">
          <Logo variant="symbol" tone="on-dark" label="ONhost" />
        </button>
      </div>
      <p class="hero__state" aria-live="polite"><span data-power-state>OFF</span></p>
      <div class="hero__copy">
        <h1>{first}{rest.length > 0 && <> <span>{rest.join(' ')}</span></>}</h1>
        {d?.lead && <p class="lead">{d.lead}</p>}
        <form class="domain" action={url('domeny')} method="get" role="search">
          <label class="sr-only" for="domain-q">Najděte si doménu</label>
          <input id="domain-q" name="q" placeholder="vase-firma.cz" autocomplete="off" />
          <Button type="submit">Ověřit doménu</Button>
        </form>
      </div>
    </div>
    {d?.included && <ul class="chips hero__chips" aria-label="V ceně každého tarifu">{d.included.slice(0, 3).map(i => <li>{i}</li>)}</ul>}
  </section>

  <Marquee label="Technologie, na kterých služby běží" items={['NVMe SSD', 'PHP 8.3', 'MariaDB', "Let's Encrypt", 'KVM', 'Git deploy', 'Composer', 'Redis', 'Node.js', 'WP-CLI', 'ModSecurity', 'IPv6']} />

  <section class="section" id="produkty">
    <div class="wrap">
      <SectionHead title="Jeden vesmír. Všechno pro váš web." lead="Od prvního webu po dedikovaný server. Jeden účet, jedna klientská zóna a jedna podpora, která zná celý váš projekt." />
      <div class="system" data-catalog>
        <ul class="system__list">
          {catalog.map((p, i) => <li data-reveal style={`--d:${i * 40}ms`}>
            <a class:list={['card', 'system__item', {'is-active': i === 0}]} href={url(p.href)} data-key={p.key}>
              <PlanetArt name={p.key} size="44px" small class="system__thumb" />
              <span class="system__text"><strong>{p.label}</strong><small>{p.note}</small></span>
              {p.from && <span class="system__price">{p.from}</span>}
            </a>
          </li>)}
        </ul>
        <div class="system__stage" aria-hidden="true">
          <div class="system__orbit" data-orbit>
            {[1, 2].map(r => <div class="ring" style={`--ring:${r}`}>
              {catalog.filter((_, i) => i % 2 === r - 1).map((p, i) => <span class="orb" style={`--at:${(i / 4 + r * .11) % 1}`}><PlanetArt name={p.key} size="100%" small /></span>)}
            </div>)}
          </div>
          {catalog.map((p, i) => <div class:list={['system__focus', {'is-active': i === 0}]} data-focus={p.key}><PlanetArt name={p.key} size="100%" tracks={1} /></div>)}
        </div>
      </div>
    </div>
  </section>

  {d?.highlights?.length && <Highlights items={d.highlights} title="Prémiový hosting, který nemusíte hlídat." planet="datacenter" />}

  <Stats title="ONhost v číslech." items={[
    {value: 99.9, decimals: 1, suffix: ' %', label: 'garantovaná dostupnost podle SLA'},
    {value: 14, suffix: ' dní', label: 'uchováváme noční zálohy webu, databází i e-mailů'},
    {value: 1, suffix: ' min', label: 'interval kontroly dostupnosti vašeho webu'},
    {value: 1, suffix: ' h', label: 'reakce podpory na urgentní výpadek'},
  ]} />

  {d?.plans?.length && <Plans plans={d.plans} note={d.priceNote} title="Férové ceny. Bez hvězdiček." id="cenik" />}

  {d?.steps?.length && <Steps items={d.steps} title={stepsTitle(d.steps.length)} />}

  <section class="section dc">
    <div class="wrap">
      <SectionHead title="Datacentrum v srdci Evropy." lead="Vlastní infrastruktura v datacentru Tier III v Praze. Odtud běží vaše weby, e-maily i servery." />
      <WorldMap />
      <ul class="dc__facts" data-reveal>
        <li><strong>Tier III</strong><span>Praha</span></li>
        <li><strong>N+1</strong><span>redundance kritických systémů</span></li>
        <li><strong>99,9 %</strong><span>SLA dostupnosti</span></li>
        <li class="dc__more"><Button href={url('datacenter')} variant="ghost">Prohlédnout datacentrum</Button></li>
      </ul>
    </div>
  </section>

  {d?.faq?.length && <Faq items={d.faq} />}

  {d?.cta && <CtaBand title={d.cta.title} text={d.cta.text} primary={d.cta.primary} secondary={d.cta.secondary} />}
</Site>

<script>
  // Vypínač: „stisk“ = rovnoměrné zmenšení symbolu; zapnutí rozsvítí vesmír kolem. Logo se jinak nemění.
  import {onPage} from '../motion/lifecycle.js';
  import {getCosmos} from '../motion/cosmos.js';
  onPage(() => {
    const scene = document.querySelector<HTMLElement>('[data-power-scene]');
    const button = document.querySelector<HTMLButtonElement>('[data-power]');
    const state = document.querySelector('[data-power-state]');
    if (!scene || !button) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const setOn = (on: boolean) => {
      scene.classList.toggle('is-on', on);
      button.setAttribute('aria-pressed', String(on));
      button.setAttribute('aria-label', on ? 'Vypnout vesmír ONhost' : 'Zapnout vesmír ONhost');
      if (state) state.textContent = on ? 'ON' : 'OFF';
      getCosmos(document.getElementById('hero-cosmos'))?.setPower(on, {duration: 1800});
    };
    const press = () => {
      button.classList.remove('is-pressed'); void button.offsetWidth; button.classList.add('is-pressed');
      setOn(!scene.classList.contains('is-on'));
    };
    button.addEventListener('click', press);
    // Bez interakce se vesmír zapne sám; kdo nechce pohyb, vidí rovnou zapnutý stav.
    const timer = reduce ? (setOn(true), 0) : window.setTimeout(() => { if (!scene.classList.contains('is-on')) press(); }, 1400);
    // Katalog: najetí nebo fokus na produkt vymění planetu uprostřed.
    const catalog = document.querySelector('[data-catalog]');
    const pick = (e: Event) => {
      const item = (e.target as Element).closest<HTMLElement>('[data-key]');
      if (!item || !catalog) return;
      catalog.querySelectorAll('[data-key]').forEach(el => el.classList.toggle('is-active', el === item));
      catalog.querySelectorAll<HTMLElement>('[data-focus]').forEach(el => el.classList.toggle('is-active', el.dataset.focus === item.dataset.key));
    };
    catalog?.addEventListener('pointerover', pick); catalog?.addEventListener('focusin', pick);
    // Oběžné dráhy běží jen ve viewportu.
    const orbit = document.querySelector('[data-orbit]');
    const io = orbit && new IntersectionObserver(([e]) => orbit.classList.toggle('is-paused', !e.isIntersecting));
    if (orbit && io) io.observe(orbit);
    return () => { clearTimeout(timer); button.removeEventListener('click', press); io?.disconnect(); catalog?.removeEventListener('pointerover', pick); catalog?.removeEventListener('focusin', pick); };
  });
</script>

<style>
  /* HERO — vypínač nad horizontem planety. Tma; stisk rozsvítí mlhovinu, hvězdy a síť na planetě (WebGL, se zálohou v CSS). */
  .hero { position: relative; min-height: calc(100svh - 32px); margin-top: -76px; padding-top: 76px; display: grid; grid-template-columns: minmax(0, 1fr); align-items: start; isolation: isolate; overflow: hidden; }
  .hero :global(.hero__cosmos) { z-index: -1; -webkit-mask-image: linear-gradient(#000 88%, transparent); mask-image: linear-gradient(#000 88%, transparent); }
  .hero__inner { display: grid; justify-items: center; text-align: center; padding-block: clamp(28px, 6vh, 72px) 0; }
  .hero__stage { position: relative; display: grid; place-items: center; width: clamp(92px, 9vw, 128px); aspect-ratio: 1; margin: 18px 0 10px; }
  .hero__switch { width: 100%; aspect-ratio: 1; border-radius: 50%; border: 0; background: none; cursor: pointer; padding: 0; }
  .hero__switch :global(.logo) { width: 100%; }
  .hero__switch.is-pressed :global(.logo) { animation: hero-press 220ms var(--ease); }
  @keyframes hero-press { 50% { scale: .94; } }
  .hero__switch:focus-visible { outline: 2px solid var(--lilac-200); outline-offset: 14px; }
  /* Dráhy kolem symbolu (mimo ochrannou zónu) se po zapnutí roztáhnou a rozsvítí. */
  .hero__ring { position: absolute; inset: -38%; border-radius: 50%; border: 1px solid transparent; scale: .7; opacity: 0;
    transition: scale var(--t-scene) var(--ease), opacity var(--t-scene) var(--ease), border-color var(--t-scene) var(--ease); }
  .hero__ring--2 { inset: -66%; border-style: dashed; transition-delay: .2s; }
  .hero.is-on .hero__ring { scale: 1; opacity: 1; border-color: color-mix(in srgb, var(--lilac) 30%, transparent); }
  .hero.is-on .hero__ring--2 { border-color: color-mix(in srgb, var(--lilac) 16%, transparent); animation: hero-spin 120s linear infinite; }
  @keyframes hero-spin { to { rotate: 360deg; } }
  .hero__state { margin: 26px 0 0; font: 600 12px/1 var(--font-body); letter-spacing: .32em; color: var(--text-faint); transition: color var(--t-move) var(--ease); }
  .hero.is-on .hero__state { color: var(--pink-hot); }
  .hero__copy { display: grid; gap: 22px; justify-items: center; margin-top: clamp(24px, 4vh, 44px); opacity: .12; translate: 0 16px; transition: opacity var(--t-scene) var(--ease) .15s, translate var(--t-scene) var(--ease) .15s; }
  .hero.is-on .hero__copy { opacity: 1; translate: 0 0; }
  .hero h1 { font-size: clamp(40px, 5.4vw, 80px); font-weight: 700; max-width: 17ch; }
  .hero h1 span { color: var(--lilac-200); }
  @media (min-width: 760px) { .hero h1 { max-width: none; } .hero h1 span { display: block; } }
  .hero .lead { max-width: 46ch; }
  .domain { display: flex; gap: 8px; width: min(100%, 540px); margin-top: 6px; padding: 8px; border-radius: 999px; background: color-mix(in srgb, var(--space-0) 60%, transparent); border: 1px solid var(--line-strong); backdrop-filter: blur(12px); text-align: left; }
  .domain input { flex: 1; min-width: 0; border: 0; background: none; color: #fff; font: 500 16px var(--font-body); padding: 0 16px; }
  .domain input::placeholder { color: var(--text-faint); }
  .domain input:focus { outline: none; }
  .domain:focus-within { border-color: var(--lilac-200); }
  .hero__chips { position: absolute; left: 50%; bottom: clamp(20px, 5vh, 44px); translate: -50% 0; justify-content: center; width: max-content; max-width: calc(100% - 32px); opacity: 0; transition: opacity var(--t-scene) var(--ease) .6s; }
  .hero.is-on .hero__chips { opacity: 1; }
  @media (max-width: 759px) { .hero { padding-bottom: 120px; } .hero__chips { position: static; translate: none; margin: 28px auto 0; width: auto; padding-inline: 16px; } }

  /* PRODUKTY — katalog: seznam vlevo, vpravo velká planeta vybraného produktu a ostatní na oběžné dráze. */
  #produkty { overflow-x: clip; }
  .system { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
  .system__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .system__item { display: flex !important; align-items: center; gap: 16px; padding: 12px 18px 12px 12px; }
  .system__item.is-active { border-color: var(--line-strong); background: linear-gradient(90deg, color-mix(in srgb, var(--brand) 55%, transparent), transparent), var(--surface); }
  .system__item :global(.system__thumb) { flex: none; }
  .system__text { display: grid; gap: 1px; flex: 1; min-width: 0; }
  .system__text strong { font: 600 17px/1.25 var(--font-display); color: #fff; }
  .system__text small { font-size: 13.5px; color: var(--text-faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .system__price { font-size: 14px; font-weight: 600; color: var(--lilac-200); white-space: nowrap; }
  /* Scéna: čtverec s pevnou výškou přes padding (spolehlivé i v Safari), vše uvnitř je umístěné absolutně. */
  .system__stage { position: relative; width: 100%; max-width: 600px; justify-self: center; }
  .system__stage::before { content: ''; display: block; padding-top: 100%; }
  .system__focus { position: absolute; left: 18%; top: 18%; width: 64%; opacity: 0; scale: .9; transition: opacity .6s var(--ease), scale .8s var(--ease); pointer-events: none; }
  .system__focus.is-active { opacity: 1; scale: 1; }
  .system__orbit { position: absolute; inset: 0; }
  .ring { position: absolute; --r: calc(36% + (var(--ring) - 1) * 12%); inset: calc(50% - var(--r)); border-radius: 50%; border: 1px dashed color-mix(in srgb, var(--lilac) 20%, transparent); }
  .orb { position: absolute; left: 0; top: 0; width: 46px; height: 46px; offset-path: circle(50% at 50% 50%); offset-rotate: 0deg; --spin: calc(80s + var(--ring) * 30s);
    animation: cat-travel var(--spin) linear infinite; animation-delay: calc(var(--spin) * var(--at) * -1); }
  .ring:nth-child(even) .orb { animation-direction: reverse; width: 38px; height: 38px; }
  @keyframes cat-travel { to { offset-distance: 100%; } }
  .system__orbit.is-paused .orb { animation-play-state: paused; }

  /* DATACENTRUM — mapa sítě přes celou šířku, pod ní fakta z živého webu. */
  .dc :global(.world-map) { margin-inline: calc(var(--gutter) * -0.5); }
  .dc__facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; align-items: center; gap: 24px; margin: 40px 0 0; padding: 28px 0 0; list-style: none; border-top: 1px solid var(--line); }
  .dc__facts li { display: grid; gap: 4px; }
  .dc__facts strong { font: 700 clamp(28px, 3vw, 40px)/1 var(--font-display); color: #fff; }
  .dc__facts span { font-size: 15px; color: var(--text-faint); }
  @media (max-width: 860px) { .dc__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } .dc__more { grid-column: 1 / -1; } }

  @media (max-width: 960px) {
    .system { grid-template-columns: minmax(0, 1fr); }
    .system__stage { order: -1; max-width: 420px; }
  }
  @media (max-width: 560px) { .system__price { display: none; } .domain { flex-direction: column; border-radius: 22px; } .domain :global(.btn) { width: 100%; } .domain input { padding: 12px 14px; } }
</style>
