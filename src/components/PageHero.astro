---
// Úvod každé podstránky. Stejná skladba všude: drobečky, nadtitulek, H1, perex, akce, „v ceně“, planeta.
import PlanetArt from './PlanetArt.astro';
import Button from './Button.astro';
import {link} from '../data/pages';
interface Crumb { label: string; href: string }
interface Props {
  crumbs: Crumb[]; eyebrow?: string; title: string; lead?: string; planet?: string; included?: string[];
  primary?: {label: string; href: string}; secondary?: {label: string; href: string}; compact?: boolean; meta?: string[];
}
const {crumbs, eyebrow, title, lead, planet, included, primary, secondary, compact = false, meta} = Astro.props;
// Nadpis se odkrývá po slovech zpod masky (jen vzhled; čtečka přečte celý nadpis z aria-label).
const words = title.split(/\s+/);
---
<section class:list={['phero', {'phero--compact': compact}]}>
  <div class="wrap phero__grid">
    <div class="phero__copy">
      <nav class="crumbs" aria-label="Drobečková navigace">
        <ol>{crumbs.map((c, i) => <li>{c.href && i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}</ol>
      </nav>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 aria-label={title}>{words.map((w, i) => <><span class="w" aria-hidden="true"><span style={`--i:${i}`}>{w}</span></span>{i < words.length - 1 && ' '}</>)}</h1>
      {lead && <p class="lead">{lead}</p>}
      {meta && meta.length > 0 && <p class="phero__meta">{meta.join(' · ')}</p>}
      {(primary || secondary) && <div class="phero__actions">
        {primary && <Button href={link(primary.href)} size="lg">{primary.label}</Button>}
        {secondary && <Button href={link(secondary.href)} variant="ghost" size="lg">{secondary.label}</Button>}
      </div>}
      {included && included.length > 0 && <ul class="chips phero__chips" aria-label="V ceně">{included.map(i => <li>{i}</li>)}</ul>}
    </div>
    {!compact && <div class:list={['phero__visual', {'phero__visual--custom': Astro.slots.has('visual')}]}>
      {Astro.slots.has('visual') ? <slot name="visual" /> : <>
        <div class="phero__orbits"><span></span><span></span></div>
        <PlanetArt name={planet} power eager size="100%" transitionName={planet ? `planet-${planet}` : undefined} />
      </>}
    </div>}
  </div>
</section>
<style>
  .phero { position: relative; padding-block: clamp(40px, 7vw, 96px) clamp(48px, 7vw, 104px); }
  .phero__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .phero--compact .phero__grid { grid-template-columns: minmax(0, 1fr); }
  .phero__copy { display: grid; gap: 22px; justify-items: start; }
  .phero__copy > :not(h1) { animation: rise 1s var(--ease) both; animation-delay: .35s; }
  .phero__copy > .crumbs, .phero__copy > .eyebrow { animation-delay: 0s; }
  .w { display: inline-block; overflow: clip; overflow-clip-margin: .12em; vertical-align: top; padding-bottom: .06em; margin-bottom: -.06em; }
  .w > span { display: inline-block; animation: word .9s var(--ease) both; animation-delay: calc(.08s + var(--i) * 55ms); }
  @keyframes word { from { translate: 0 105%; } }
  .phero h1 { font-size: var(--fs-display); font-weight: 700; max-width: 14ch; }
  .phero--compact h1 { font-size: clamp(38px, 5vw, 68px); max-width: 22ch; }
  .phero__meta { margin: 0; font-size: 14px; color: var(--text-faint); }
  .phero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .phero__chips { margin-top: 8px; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 6px; padding: 0; list-style: none; font-size: 13.5px; color: var(--text-faint); }
  .crumbs li + li::before { content: '/'; margin-right: 6px; opacity: .5; }
  .crumbs a { text-decoration: none; } .crumbs a:hover { color: #fff; }
  .crumbs [aria-current] { color: var(--lilac-200); }
  .phero__visual { position: relative; display: grid; place-items: center; }
  /* Při odrolování planeta lehce odplouvá a zmenšuje se — hloubka bez JS. */
  @supports (animation-timeline: view()) {
    .phero__visual { animation: float-away linear both; animation-timeline: view(); animation-range: exit 0% exit 100%; }
    @keyframes float-away { to { translate: 0 -12%; scale: .86; opacity: .55; } }
  }
  .phero__orbits { position: absolute; inset: -6%; pointer-events: none; }
  .phero__orbits span { position: absolute; inset: 0; border-radius: 50%; border: 1px dashed var(--line); animation: spin 140s linear infinite; }
  .phero__orbits span + span { inset: 12%; border-style: solid; border-color: color-mix(in srgb, var(--lilac) 9%, transparent); animation-duration: 200s; animation-direction: reverse; }
  @keyframes spin { to { rotate: 360deg; } }
  @keyframes rise { from { opacity: 0; translate: 0 18px; } }
  @media (max-width: 900px) {
    .phero__grid { grid-template-columns: minmax(0, 1fr); }
    .phero__visual { order: -1; width: min(72vw, 320px); justify-self: center; margin-bottom: -8px; }
  }
</style>
