---
// Hlavička sekce: nadpis a pod ním perex (max. 60 znaků na řádek). Nadtitulek jen tam, kde nese informaci.
interface Props { eyebrow?: string; title: string; lead?: string; level?: 'h1' | 'h2'; id?: string; align?: 'start' | 'center' }
const {eyebrow, title, lead, level = 'h2', id, align = 'start'} = Astro.props;
const H = level;
---
<header class:list={['shead', `shead--${align}`]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <H class="shead__title" id={id}>{title}</H>
  {lead && <p class="lead">{lead}</p>}
</header>
<style>
  .shead { display: grid; gap: 18px; justify-items: start; margin-bottom: clamp(36px, 5vw, 60px); }
  .shead__title { font-size: var(--fs-h2); font-weight: 700; max-width: 20ch; }
  .shead--center { justify-items: center; text-align: center; }
  .shead--center .lead { margin-inline: auto; }
</style>
