---
// Hlavička sekce: vždy zarovnaná vlevo; s perexem se na širokých displejích rozdělí do dvou sloupců.
interface Props { eyebrow?: string; title: string; lead?: string; level?: 'h1' | 'h2'; split?: boolean; id?: string }
const {eyebrow, title, lead, level = 'h2', split = true, id} = Astro.props;
const H = level;
---
<header class:list={['shead', {'shead--split': split && lead}]} data-reveal>
  <div class="shead__main">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <H class="shead__title" id={id}>{title}</H>
  </div>
  {lead && <p class="lead shead__lead">{lead}</p>}
</header>
<style>
  .shead { display: grid; gap: 18px; margin-bottom: clamp(36px, 5vw, 64px); }
  .shead__main { display: grid; gap: 18px; max-width: 24ch; }
  .shead__title { font-size: var(--fs-h2); font-weight: 700; }
  @media (min-width: 960px) {
    .shead--split { grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); align-items: end; gap: 56px; }
    .shead--split .shead__main { max-width: none; }
    .shead--split .shead__lead { padding-bottom: 8px; }
  }
</style>
