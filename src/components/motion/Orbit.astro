---
interface Props { size?: string; duration?: number; rings?: number; paused?: boolean; class?: string; }
const { size = 'min(100%, 360px)', duration = 48, rings = 2, paused = false, class: className } = Astro.props;
---
<div class:list={['orbit',className]} data-paused={paused} style={`--orbit-size:${size};--orbit-duration:${Math.max(1,duration)}s`}>
  <div class="orbit-decoration" aria-hidden="true">
    {Array.from({length:Math.min(4,Math.max(1,rings))},(_,i) => <div class="orbit-ring" style={`--i:${i}`}><span class="orbit-planet"></span></div>)}
  </div>
  <div class="orbit-content"><slot /></div>
  <div class="orbit-planets"><slot name="planets" /></div>
</div>
<style>
  .orbit { width:var(--orbit-size); aspect-ratio:1; position:relative; display:grid; place-items:center; isolation:isolate; }
  .orbit-decoration,.orbit-planets { position:absolute; inset:0; pointer-events:none; }
  .orbit-ring { position:absolute; inset:calc(4% + var(--i)*7%); border:1px solid #bb88eb38; border-radius:50%; animation:orbit-spin calc(var(--orbit-duration) + var(--i)*13s) linear infinite; animation-delay:calc(var(--i)*-8s); }
  .orbit-planet { position:absolute; width:12px; height:12px; border-radius:50%; top:50%; left:-6px; background:var(--lilac); box-shadow:0 0 24px #bb88eb55; }
  .orbit-ring:nth-child(even) .orbit-planet { background:var(--pink); }
  .orbit-content { position:relative; z-index:1; }
  [data-paused='true'] .orbit-ring { animation-play-state:paused; }
  @keyframes orbit-spin { to { transform:rotate(360deg); } }
  @media(prefers-reduced-motion:reduce) { .orbit-ring { animation:none; } }
</style>
<script>
  import { observeOrbits } from '../../motion/orbit.js';
  import { onPage } from '../../motion/lifecycle.js';
  onPage(() => observeOrbits(Array.from(document.querySelectorAll<HTMLElement>('.orbit'))));
</script>
