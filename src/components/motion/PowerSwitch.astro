---
interface Props { target: string; label?: string; size?: number; class?: string; }
const { target, label = 'Zapnout vesmír', size = 96, class: className } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<button type="button" class:list={['power-switch',className]} data-cosmos-target={target} aria-label={label} aria-pressed="false" aria-controls={target}>
  <img src={`${base}/brand/onhost-symbol.svg`} alt="" width={Math.max(50,size)} height={Math.max(50,size)} />
  <span class="power-state" data-power-state>ON</span>
</button>
<style>
  .power-switch { display:inline-flex; flex-direction:column; align-items:center; gap:24px; padding:44px; border:0; border-radius:0; background:transparent; color:var(--lilac-200); cursor:pointer; }
  .power-switch img { display:block; min-width:50px; max-width:100%; }
  .power-switch:focus-visible { outline:2px solid var(--lilac-200); outline-offset:6px; }
  .power-state { font:600 12px var(--font-body); letter-spacing:.2em; }
</style>
<script>
  import { bindPower } from '../../motion/power.js';
  import { onPage } from '../../motion/lifecycle.js';
  onPage(() => {
    const cleanups = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-cosmos-target]')).map(bindPower);
    return () => cleanups.forEach(cleanup => cleanup());
  });
</script>
