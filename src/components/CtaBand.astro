---
// Závěrečná výzva: plná brandová fialová (povolené pozadí z manuálu), bez přechodu. Symbol stojí vlevo,
// kolem něj se při odkrytí rozběhnou oběžné dráhy — logo samo zůstává beze změny.
import Button from './Button.astro';
import Logo from './Logo.astro';
import {link} from '../data/pages';
interface Props { title: string; text?: string; primary?: {label: string; href: string}; secondary?: {label: string; href: string} }
const {title, text, primary = {label: 'Vybrat hosting', href: '/webhosting'}, secondary} = Astro.props;
---
<section class="section cta-section">
  <div class="wrap">
    <div class="cta" data-reveal>
      <div class="cta__mark" aria-hidden="true"><span></span><span></span><span></span><Logo variant="symbol" tone="on-dark" /></div>
      <div class="cta__copy">
        <h2>{title}</h2>
        {text && <p>{text}</p>}
        <div class="cta__actions">
          <Button href={link(primary.href)} variant="light" size="lg">{primary.label}</Button>
          {secondary && <Button href={link(secondary.href)} variant="ghost" size="lg" class="cta__ghost">{secondary.label}</Button>}
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .cta { position: relative; overflow: hidden; border-radius: var(--radius-lg); display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: clamp(28px, 6vw, 88px);
    padding: clamp(40px, 6vw, 88px) clamp(24px, 6vw, 88px); background: var(--brand); }
  .cta__mark { position: relative; width: clamp(96px, 13vw, 168px); aspect-ratio: 1; display: grid; place-items: center; }
  .cta__mark :global(.logo) { width: 100%; position: relative; }
  .cta__mark span { position: absolute; inset: -30%; border-radius: 50%; border: 1px solid #ffffff2e; transition: scale 1.6s var(--ease), opacity 1.6s var(--ease); }
  .cta__mark span:nth-child(2) { inset: -62%; border-color: #ffffff1c; transition-delay: .15s; }
  .cta__mark span:nth-child(3) { inset: -100%; border-color: #ffffff12; transition-delay: .3s; }
  .cta.reveal-pending .cta__mark span { scale: .6; opacity: 0; }
  .cta__copy { position: relative; display: grid; gap: 18px; justify-items: start; }
  .cta h2 { font-size: var(--fs-h2); color: #fff; max-width: 15ch; }
  .cta p { margin: 0; font-size: var(--fs-lead); max-width: 48ch; color: #fff; opacity: .9; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .cta :global(.cta__ghost) { border-color: #ffffff66; color: #fff; }
  .cta :global(.cta__ghost:hover) { background: #ffffff1f; border-color: #fff; }
  @media (max-width: 760px) { .cta { grid-template-columns: minmax(0, 1fr); } .cta__mark { width: 88px; margin: 12px 0 0 12px; } }
</style>
