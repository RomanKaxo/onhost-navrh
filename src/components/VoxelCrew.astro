---
// Kostičkové herní postavičky (vlastní, generické) chodí po povrchu planety Gamehosting.
// Každá postavička je skupina kvádrů; chůze = kyvadlo nohou a rukou kolem kyčle/ramene, tělo se pohupuje.
// Celá skupina obíhá po oblouku kolem středu planety (cx, cy, r v procentech obrázku planety).
interface Props { cx?: number; cy?: number; r?: number }
const {cx = 50, cy = 55, r = 31} = Astro.props;
// Barvy jen z brandmanuálu (+ bílá na oči).
const crew = [
  {hair: '#3C096C', shirt: '#E91E7A', pants: '#2C0A3E', skin: '#F1E2FF', item: 'sword', speed: 22, delay: 0, arc: 34},
  {hair: '#F72585', shirt: '#BB88EB', pants: '#3C096C', skin: '#E0BEFF', item: 'block', speed: 28, delay: -9, arc: 26, jump: true},
];
---
<div class="crew" style={`--cx:${cx}%;--cy:${cy}%;--r:${r}`} aria-hidden="true">
  {crew.map((c, i) => (
    <div class:list={['walker', {'walker--jump': c.jump}]} style={`--speed:${c.speed}s;--delay:${c.delay}s;--arc:${c.arc}deg;--i:${i}`}>
      <svg class="hero" viewBox="0 0 24 40" width="24" height="40">
        <g class="body-bob">
          <g class="leg leg--back"><rect x="8" y="26" width="4" height="12" fill={c.pants} /><rect x="8" y="36" width="4" height="2" fill="#12001E" opacity=".5" /></g>
          <g class="arm arm--back"><rect x="2" y="14" width="4" height="12" fill={c.shirt} opacity=".75" /><rect x="2" y="24" width="4" height="2" fill={c.skin} opacity=".8" /></g>
          <rect x="6" y="14" width="12" height="12" fill={c.shirt} />
          <rect x="6" y="14" width="12" height="3" fill="#fff" opacity=".12" />
          <g class="head"><rect x="6" y="2" width="12" height="12" fill={c.skin} /><rect x="6" y="2" width="12" height="4" fill={c.hair} /><rect x="6" y="2" width="3" height="8" fill={c.hair} />
            <rect x="12" y="8" width="2" height="2" fill="#12001E" /><rect x="15" y="8" width="2" height="2" fill="#12001E" /></g>
          <g class="leg leg--front"><rect x="12" y="26" width="4" height="12" fill={c.pants} /><rect x="12" y="36" width="4" height="2" fill="#12001E" opacity=".5" /></g>
          <g class="arm arm--front"><rect x="18" y="14" width="4" height="12" fill={c.shirt} /><rect x="18" y="24" width="4" height="2" fill={c.skin} />
            {c.item === 'sword'
              ? <g class="item"><rect x="19" y="10" width="2" height="16" fill="#F1E2FF" /><rect x="17" y="24" width="6" height="2" fill="#3C096C" /><rect x="19" y="26" width="2" height="3" fill="#3C096C" /></g>
              : <g class="item"><rect x="17" y="23" width="7" height="7" fill="#BB88EB" /><rect x="17" y="23" width="7" height="2" fill="#F1E2FF" opacity=".6" /></g>}
          </g>
        </g>
      </svg>
    </div>
  ))}
</div>
<style>
  /* Vrstva přes obrázek planety; středem otáčení je střed koule. */
  .crew { position: absolute; inset: 0; pointer-events: none; z-index: 2; container-type: inline-size; }
  .walker { position: absolute; left: var(--cx); top: var(--cy); width: 0; height: 0;
    animation: patrol var(--speed) ease-in-out infinite alternate; animation-delay: var(--delay); }
  /* Postavička stojí na povrchu: posun nahoru o poloměr koule (v % šířky obrázku přes kontejner) a natočení po oblouku. */
  .hero { position: absolute; left: 0; bottom: 0; width: calc(var(--r) * .24cqw); height: auto; translate: -50% calc(var(--r) * -1cqw); transform-origin: 50% 100%;
    animation: face var(--speed) steps(1) infinite alternate; animation-delay: var(--delay); overflow: visible; }
  @keyframes patrol { from { rotate: calc(var(--arc) * -1); } to { rotate: var(--arc); } }
  /* Otočení čelem po směru chůze: první polovinu cesty jde doprava, při návratu doleva. */
  @keyframes face { 0% { scale: 1 1; } 100% { scale: -1 1; } }
  .hero g { transform-box: fill-box; }
  .leg, .arm { transform-origin: 50% 0%; animation: swing .6s ease-in-out infinite alternate; }
  .leg--front, .arm--back { animation-direction: alternate-reverse; }
  .body-bob { animation: bob .3s ease-in-out infinite alternate; }
  @keyframes swing { from { rotate: -28deg; } to { rotate: 28deg; } }
  @keyframes bob { to { translate: 0 -.8px; } }
  /* Druhá postavička občas vyskočí; první občas máchne mečem. */
  .walker--jump .hero { animation: face var(--speed) steps(1) infinite alternate, jump 4.2s ease-in-out infinite; animation-delay: var(--delay), -1s; }
  @keyframes jump { 0%, 70%, 100% { translate: -50% calc(var(--r) * -1cqw); } 80% { translate: -50% calc(var(--r) * -1cqw - 9cqw); } 90% { translate: -50% calc(var(--r) * -1cqw); } }
  .walker:not(.walker--jump) .arm--front { animation: swing .6s ease-in-out infinite alternate, slash 5s ease-in-out infinite; }
  @keyframes slash { 0%, 84%, 100% { rotate: 0deg; } 88% { rotate: -150deg; } 94% { rotate: 20deg; } }
  @media (prefers-reduced-motion: reduce) { .walker, .hero, .leg, .arm, .body-bob { animation: none !important; } }
</style>
