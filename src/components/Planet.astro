---
import {planetFor, planets} from '../data/planets';
import {globeSnapshot} from '../motion/globe.js';
interface Props { name?: string; size?: string; power?: boolean; class?: string; transitionName?: string; animate?: boolean }
const {name, size = 'min(100%, 420px)', power = false, class: className, transitionName, animate = false} = Astro.props;
const key = name && planets[name] ? name : 'web';
const look = planetFor(key);
const numericSize = /^\d+(?:\.\d+)?px$/.test(size) ? parseFloat(size) : 420;
const small = numericSize < 120;
const snapshot = globeSnapshot(key, small);
---
<div class:list={['planet', className]} style={`--size:${size};--accent:${look.c1}`} aria-hidden="true" transition:name={transitionName}>
  <div class="planet__poster" set:html={snapshot} />
  {animate && <canvas data-globe-canvas={key} data-power={String(power)} aria-hidden="true"></canvas>}
</div>
<script>
  import '../motion/globe.js';
</script>
<style>
  .planet{position:relative;width:var(--size);max-width:100%;aspect-ratio:1;isolation:isolate}
  .planet__poster,.planet canvas{position:absolute;inset:0;width:100%;height:100%}
  .planet__poster :global(svg){width:100%;height:100%}
  .planet canvas{opacity:0;transition:opacity 180ms ease}
  .planet.globe-ready canvas{opacity:1}
  .planet.globe-ready .planet__poster{visibility:hidden}
  @media(prefers-reduced-motion:reduce){.planet canvas{transition:none}}
</style>
