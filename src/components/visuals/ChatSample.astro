---
// AI asistent: ukázková konverzace (vymyšlený příklad, proto štítek „Ukázka konverzace“).
import Frame from './Frame.astro';
---
<Frame title="Klientská zóna — AI asistent" note="Ukázka konverzace">
  <div class="chat">
  <div class="msg msg--me" style="--at:.5s">Proč mi nechodí e-maily na novou doménu?</div>
  <div class="reply">
  <div class="typing" style="--at:1.3s" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="msg msg--ai" style="--at:2.6s">
    <p>Podíval jsem se na DNS vaší domény. Doména míří na hosting, ale chybí <strong>MX záznam</strong>, takže pošta neví, kam má dorazit.</p>
    <p>Přidejte ho v sekci <strong>Domény → Záznamy DNS</strong>. Změna se obvykle projeví za 15–60 minut, nejpozději do 24 hodin.</p>
  </div>
  </div>
  <div class="chat__actions" style="--at:3.4s"><span>Otevřít Záznamy DNS</span><span>Založit ticket</span></div>
  </div>
</Frame>
<style>
  .chat { display: grid; gap: 12px; }
  .msg, .typing, .chat__actions { opacity: 0; translate: 0 10px; animation: chat-rise .5s var(--ease) forwards; animation-delay: var(--at); }
  .msg { max-width: 88%; padding: 12px 16px; border-radius: 16px; font-size: 15px; line-height: 1.5; }
  .msg p { margin: 0; } .msg p + p { margin-top: 8px; }
  .msg strong { color: #fff; }
  .msg--me { justify-self: end; background: var(--pink); color: #fff; border-bottom-right-radius: 4px; }
  .reply { display: grid; align-items: start; } .reply > * { grid-area: 1 / 1; }
  .msg--ai { justify-self: start; background: color-mix(in srgb, var(--brand) 45%, transparent); border: 1px solid var(--line-strong); color: var(--lilac-50); border-bottom-left-radius: 4px; }
  .typing { justify-self: start; display: flex; gap: 5px; padding: 14px 16px; border-radius: 16px; background: color-mix(in srgb, var(--brand) 35%, transparent); animation: chat-rise .4s var(--ease) forwards var(--at), chat-gone .2s forwards 2.5s; }
  .typing i { width: 6px; height: 6px; border-radius: 50%; background: var(--lilac-200); animation: chat-bounce 1s ease-in-out infinite; }
  .typing i:nth-child(2) { animation-delay: .15s; } .typing i:nth-child(3) { animation-delay: .3s; }
  .chat__actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .chat__actions span { padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line-strong); font-size: 13.5px; color: var(--lilac-200); }
  @keyframes chat-rise { to { opacity: 1; translate: 0 0; } }
  @keyframes chat-gone { to { opacity: 0; } }
  @keyframes chat-bounce { 50% { translate: 0 -4px; opacity: .5; } }
  @media (prefers-reduced-motion: reduce) { .msg, .chat__actions { opacity: 1; translate: none; animation: none; } .typing { display: none; } }
</style>
