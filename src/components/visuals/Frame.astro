---
// Rám pro ilustrace rozhraní (terminál, klientská zóna, chat). Vždy nese štítek, že jde o ilustraci.
interface Props { title: string; note?: string; class?: string }
const {title, note = 'Ilustrace', class: className} = Astro.props;
---
<figure class:list={['frame', className]}>
  <div class="frame__bar" aria-hidden="true"><span></span><span></span><span></span><b>{title}</b></div>
  <div class="frame__body"><slot /></div>
  <figcaption class="frame__note">{note}</figcaption>
</figure>
<style>
  .frame { position: relative; width: 100%; margin: 0; border-radius: var(--radius); border: 1px solid var(--line-strong); background: color-mix(in srgb, #0b0014 88%, transparent);
    box-shadow: 0 40px 120px -40px color-mix(in srgb, var(--brand) 90%, transparent), 0 0 0 1px #ffffff06 inset; backdrop-filter: blur(10px); overflow: hidden; animation: frame-in 1s var(--ease) both .2s; }
  .frame__bar { display: flex; align-items: center; gap: 7px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
  .frame__bar span { width: 10px; height: 10px; border-radius: 50%; background: color-mix(in srgb, var(--lilac) 35%, transparent); }
  .frame__bar span:first-child { background: color-mix(in srgb, var(--pink) 70%, transparent); }
  .frame__bar b { margin-left: 10px; font: 500 12.5px/1 var(--font-body); color: var(--text-faint); }
  .frame__body { padding: 20px 22px 24px; }
  .frame__note { position: absolute; right: 14px; top: 10px; padding: 3px 9px; border-radius: 999px; font: 600 10.5px/1.5 var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: var(--lilac-200); border: 1px solid var(--line); }
  @keyframes frame-in { from { opacity: 0; translate: 0 24px; } }
</style>
