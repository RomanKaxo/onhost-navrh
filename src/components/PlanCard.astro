---
interface Props { name: string; price: string; period?: string; features?: string[]; featured?: boolean; href?: string; index?: number }
const {name, price, period, features = [], featured = false, href = 'https://onhost.cz/panel', index = 0} = Astro.props;
---
<article class:list={['card', 'plan', {'plan--featured': featured}]} data-reveal style={`--d:${index * 60}ms`}>
  {featured && <p class="plan__badge">Nejoblíbenější</p>}
  <h3 class="plan__name">{name}</h3>
  <p class="plan__price"><strong>{price}</strong>{period && <span>/ {period}</span>}</p>
  <ul class="plan__features">{features.map(f => <li>{f}</li>)}</ul>
  <a class="plan__cta" href={href} aria-label={`Objednat tarif ${name}`}>Objednat<span aria-hidden="true">→</span></a>
</article>
<style>
  .plan { display: flex; flex-direction: column; gap: 18px; }
  /* „Nabití“: po najetí oběhne rámeček světlo (kuželový přechod maskovaný na 1px okraj). */
  .plan::after { content: ''; position: absolute; inset: -1px; border-radius: inherit; padding: 1px; pointer-events: none; opacity: 0;
    background: conic-gradient(from var(--charge, 0deg), transparent 0 62%, var(--lilac-200) 74%, var(--pink-hot) 82%, transparent 90%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
    transition: opacity var(--t-move) var(--ease); }
  .plan:hover::after, .plan:focus-within::after { opacity: 1; animation: charge 2.4s linear infinite; }
  .plan--featured::after { opacity: .7; animation: charge 5s linear infinite; }
  @property --charge { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  @keyframes charge { to { --charge: 360deg; } }
  .plan--featured { border-color: color-mix(in srgb, var(--pink) 70%, transparent);
    background: linear-gradient(180deg, color-mix(in srgb, var(--brand) 72%, transparent), color-mix(in srgb, #2a0544 70%, transparent)); box-shadow: 0 30px 80px -40px color-mix(in srgb, var(--pink) 70%, transparent); }
  .plan__badge { position: absolute; top: -12px; left: 22px; margin: 0; padding: 5px 12px; border-radius: 999px; background: var(--pink); color: #fff; font: 600 12px/1 var(--font-body); }
  .plan__name { font-size: 24px; }
  .plan__price { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; }
  .plan__price strong { font: 700 clamp(32px, 3vw, 42px)/1 var(--font-display); color: #fff; white-space: nowrap; }
  .plan__price span { color: var(--lilac-200); font-size: 15px; }
  .plan__features { list-style: none; margin: 0; padding: 18px 0 0; border-top: 1px solid var(--line); display: grid; gap: 10px; color: var(--text-dim); font-size: 15px; flex: 1; align-content: start; }
  .plan__features li { padding-left: 22px; position: relative; }
  .plan__features li::before { content: ''; position: absolute; left: 0; top: .55em; width: 8px; height: 8px; border-radius: 50%; background: var(--pink); box-shadow: 0 0 0 4px color-mix(in srgb, var(--pink) 20%, transparent); }
  .plan__features li:first-child { color: var(--text-strong); font-weight: 500; }
  .plan__cta { display: inline-flex; justify-content: space-between; align-items: center; gap: 10px; padding: 14px 18px; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 15px;
    background: color-mix(in srgb, var(--lilac) 14%, transparent); color: #fff; transition: background-color var(--t-micro) var(--ease); }
  .plan--featured .plan__cta { background: var(--pink); }
  .plan__cta:hover { background: var(--pink-hot); }
</style>
