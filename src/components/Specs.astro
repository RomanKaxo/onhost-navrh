---
// Parametry jako dlaždice: hodnota velká, popisek malý. Žádná tabulka s linkami.
import SectionHead from './SectionHead.astro';
interface Props { items: {label: string; value: string}[]; title?: string; lead?: string }
const {items, title = 'Technické parametry', lead} = Astro.props;
---
<section class="section">
  <div class="wrap">
    <SectionHead title={title} lead={lead} />
    <dl class="specs">
      {items.map((item, i) => <div class="spec" data-reveal style={`--d:${(i % 4) * 50}ms`}><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
    </dl>
  </div>
</section>
<style>
  .specs { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 1px; margin: 0; border-radius: var(--radius); overflow: hidden;
    background: var(--line); border: 1px solid var(--line); }
  .spec { display: grid; align-content: space-between; gap: 18px; min-height: 140px; padding: 22px 24px; background: color-mix(in srgb, var(--space-0) 88%, var(--brand)); }
  dt { font: 600 12.5px/1.3 var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: var(--text-faint); }
  dd { margin: 0; font: 600 clamp(18px, 1.6vw, 22px)/1.3 var(--font-display); color: var(--text-strong); text-wrap: balance; }
</style>
