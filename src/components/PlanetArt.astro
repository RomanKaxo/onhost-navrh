---
// Ilustrovaná planeta produktu (obrázek z public/planets). Kolem ní běží tenké dráhy s datovými pakety.
// „Zapnutí“ při načtení = planeta se z tmy rozsvítí a dráhy se dokreslí. Když obrázek chybí, použije se vektorová planeta.
import fs from 'node:fs';
import path from 'node:path';
import Planet from './Planet.astro';
import VoxelCrew from './VoxelCrew.astro';
interface Props { name?: string; size?: string; power?: boolean; class?: string; transitionName?: string; tracks?: number; eager?: boolean; small?: boolean }
const {name = 'web', size = 'min(100%, 520px)', power = false, class: className, transitionName, tracks = 0, eager = false, small = false} = Astro.props;
const dir = path.join(process.cwd(), 'public', 'planets');
const has = fs.existsSync(path.join(dir, `${name}.webp`));
// Gamehosting: když existuje planeta bez postav (game-base), chodí po ní animované postavičky.
// Poloha koule v obrázku (střed a poloměr v % šířky) je v public/planets/crew.json.
const crewFile = path.join(dir, 'crew.json');
const crew = !small && name === 'game' && fs.existsSync(path.join(dir, 'game-base.webp')) && fs.existsSync(crewFile) ? JSON.parse(fs.readFileSync(crewFile, 'utf8')) : null;
const file = crew ? 'game-base' : name;
const manifestFile = path.join(dir, 'manifest.json');
const alts: Record<string, string> = fs.existsSync(manifestFile) ? JSON.parse(fs.readFileSync(manifestFile, 'utf8')) : {};
const alt = typeof alts[name] === 'string' ? alts[name] : '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = `${base}/planets/${file}.webp`, sm = `${base}/planets/${name}-sm.webp`, md = `${base}/planets/${file}-md.webp`;
const hasMd = fs.existsSync(path.join(dir, `${file}-md.webp`));
---
{has ? (
  <div class:list={['pa', {'pa--power': power, 'pa--small': small}, className]} style={`--size:${size}`} transition:name={transitionName}>
    {!small && <div class="pa__glow" aria-hidden="true"></div>}
    {!small && Array.from({length: Math.min(tracks, 2)}, (_, i) => <div class="pa__track pa__track--back" style={`--i:${i}`} aria-hidden="true"><span class="pa__packet"></span><span class="pa__packet pa__packet--2"></span></div>)}
    <img src={small ? sm : src} srcset={small ? undefined : crew ? `${hasMd ? `${md} 512w, ` : ''}${src} 1024w` : `${sm} 256w, ${hasMd ? `${md} 512w, ` : ''}${src} 1024w`} sizes={small ? undefined : size}
      alt={alt} width={small ? 256 : 1024} height={small ? 256 : 1024} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
    {crew && <VoxelCrew cx={crew.cx} cy={crew.cy} r={crew.r} />}
    {!small && Array.from({length: Math.min(tracks, 2)}, (_, i) => <div class="pa__track pa__track--front" style={`--i:${i}`} aria-hidden="true"><span class="pa__packet"></span><span class="pa__packet pa__packet--2"></span></div>)}
  </div>
) : <Planet name={name} size={size} power={power} class={className} transitionName={transitionName} />}
<style>
  .pa { position: relative; width: var(--size); aspect-ratio: 1; isolation: isolate; }
  /* Čtvercový obrázek se do stránky rozplyne: maska drží jen planetu a její atmosféru. */
  /* Ilustrace mají průhledné pozadí: žádná maska, jen měkká záře za planetou a pomalé vznášení. */
  .pa img { position: relative; width: 100%; height: auto; animation: drift 14s ease-in-out infinite alternate; filter: drop-shadow(0 30px 60px #12001Ecc); }
  .pa__glow { position: absolute; inset: 14%; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--pink) 34%, transparent), color-mix(in srgb, var(--brand) 30%, transparent) 45%, transparent 70%); filter: blur(30px); }
  .pa--power .pa__glow { animation: glow-on 2.2s var(--ease) both; }
  @keyframes glow-on { from { opacity: 0; scale: .6; } }
  @keyframes drift { to { translate: 0 -1.6%; } }
  .pa--small img { animation: none; }
  .pa--power img { animation: power-on 2s var(--ease) both, drift 14s ease-in-out 2s infinite alternate; }
  @keyframes power-on { 0% { filter: brightness(.06) saturate(.2) drop-shadow(0 30px 60px #12001Ecc); } 35% { filter: brightness(.25) saturate(.5) drop-shadow(0 30px 60px #12001Ecc); } 100% { filter: drop-shadow(0 30px 60px #12001Ecc); } }
  /* Dráhy: vlasové elipsy s pakety (malé čtverečky), přední polovina před planetou, zadní za ní. */
  .pa__track { position: absolute; inset: calc(6% - var(--i) * 5%); rotate: calc(-18deg + var(--i) * 34deg); pointer-events: none; }
  /* Stejná dráha dvakrát: zadní kopie pod planetou, přední (jen spodní půlka elipsy) nad ní. */
  .pa__track--back { z-index: -1; }
  .pa__track--front { z-index: 1; clip-path: inset(50% 0 0 0); }
  .pa__track::before { content: ''; position: absolute; inset: 33% 0; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--lilac) 26%, transparent); }
  .pa__packet { position: absolute; left: 50%; top: 50%; width: 5px; height: 5px; margin: -2.5px; border-radius: 1px; background: var(--lilac-50); box-shadow: 0 0 8px var(--lilac-200);
    offset-path: ellipse(50% 17% at 50% 50%); offset-rotate: 0deg; animation: packet calc(16s + var(--i) * 7s) linear infinite; }
  .pa__packet--2 { background: var(--pink-hot); box-shadow: 0 0 8px var(--pink); animation-delay: calc(-6s - var(--i) * 3s); }
  @keyframes packet { from { offset-distance: 0%; } to { offset-distance: 100%; } }
  .pa--power .pa__track::before { animation: draw 1.6s var(--ease) both .5s; }
  @keyframes draw { from { opacity: 0; scale: .85; } }
  @media (prefers-reduced-motion: reduce) { .pa img, .pa__packet, .pa__track::before { animation: none !important; } }
</style>
