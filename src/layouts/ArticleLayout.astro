---
// Články, návody a právní texty: úzký sloupec pro čtení, obsah článku po straně.
import Site from './Site.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import Related from '../components/Related.astro';
import CtaBand from '../components/CtaBand.astro';
import {render} from 'astro:content';
import {allPages, crumbs, readingTime, type Page} from '../data/pages';
interface Props { page: Page }
const {page} = Astro.props;
const d = page.data;
const {Content, headings} = await render(page);
const toc = headings.filter(h => h.depth === 2);
const pages = await allPages();
const related = (d.related ?? []).map(s => pages.find(p => p.data.slug === s)).filter((p): p is Page => Boolean(p)).slice(0, 3);
const date = d.date && !Number.isNaN(Date.parse(d.date)) ? new Date(d.date).toLocaleDateString('cs-CZ', {day: 'numeric', month: 'long', year: 'numeric'}) : d.date;
const meta = d.kind === 'legal' ? [] : [date, `${readingTime(page.body)} min čtení`].filter((x): x is string => Boolean(x));
const cta = d.cta ?? (d.kind === 'legal' ? undefined : {title: 'Nefunguje to podle návodu?', text: 'Napište nám ticket. Projdeme to s vámi krok za krokem.', primary: {label: 'Napsat podpoře', href: '/kontakt'}, secondary: {label: 'Znalostní báze', href: '/znalostni-baze'}});
---
<Site title={d.title} description={d.description}>
  <PageHero compact crumbs={crumbs(d.slug, d.title)} eyebrow={d.eyebrow} title={d.headline ?? d.title} lead={d.lead} meta={meta} />
  <section class="section article">
    <div class:list={['wrap', 'article__grid', {'article__grid--toc': toc.length > 2}]}>
      {toc.length > 2 && <nav class="toc" aria-label="Obsah stránky">
        <p class="eyebrow">Obsah</p>
        <ol>{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>}
      <article class="prose">
        {d.sample && <p><span class="sample-tag">ukázkový text</span></p>}
        {d.steps?.length && <ol class="article__steps">{d.steps.map(s => <li><strong>{s.title}</strong> {s.text}</li>)}</ol>}
        <Content />
      </article>
    </div>
  </section>
  {d.faq?.length && <Faq items={d.faq} />}
  <Related pages={related} />
  {cta && <CtaBand title={cta.title} text={cta.text} primary={cta.primary} secondary={cta.secondary} />}
</Site>
<style>
  .article { padding-top: 0; }
  .article__grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .article__grid--toc { grid-template-columns: minmax(200px, .38fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .toc { position: sticky; top: 110px; display: grid; gap: 16px; padding: 22px 22px 18px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); }
  .toc ol { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; counter-reset: t; }
  .toc li { counter-increment: t; }
  .toc a { display: grid; grid-template-columns: 26px 1fr; padding: 7px 0; font-size: 15px; line-height: 1.4; color: var(--text-dim); text-decoration: none; }
  .toc a::before { content: counter(t, decimal-leading-zero); font: 600 12px/1.9 var(--font-body); color: var(--pink-hot); }
  .toc a:hover { color: #fff; }
  .article .prose { max-width: 70ch; }
  @media (max-width: 960px) { .article__grid--toc { grid-template-columns: minmax(0, 1fr); } .toc { position: static; } }
</style>
